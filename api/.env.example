# Salin file ini menjadi .env lalu isi nilainya (jangan commit .env)
# Supabase > Project Settings > API Keys
# Pakai SECRET key (sb_secret_...). Hanya untuk server, jangan dipakai di frontend.
# SUPABASE_URL tanpa garis miring di akhir dan tanpa /rest/v1
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_secret_isi_dengan_secret_key
PORT=3000
